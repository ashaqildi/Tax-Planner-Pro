# Server only. On Vercel set DATABASE_URL separately in project environment settings.
# Supabase uses the transaction pooler on port 6543; the app bundles its public CA.
# Use the exact URI from Connect and URL-encode special password characters.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
# Cosmetic browser gate; public in the JS bundle, NOT API authentication.
NEXT_PUBLIC_ACCESS_CODE=choose-your-display-code
# Keep disabled outside the original two-port local runner.
LOCAL_MODE=0
